{
  "name": "syncscreen",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal synchronized watch-party room.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "test": "node --test --test-concurrency=1 test/auth.test.js test/sync.test.js test/video-source.test.mjs",
    "test:e2e": "node --test test/e2e.js",
    "test:e2e:account": "node --test test/account-e2e.js",
    "test:e2e:youtube": "node --test test/youtube-e2e.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "hls.js": "^1.7.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
